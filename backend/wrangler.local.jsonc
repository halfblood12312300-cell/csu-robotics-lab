{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "csu-robotics-api-local",
  "main": "index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": false,
  "vars": {
    "FRONTEND_ORIGIN": "http://localhost:5173",
    "FRONTEND_BASE_PATH": "/csu-robotics-lab"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "csu-robotics-lab-local",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "csu-robotics-media-local" }
  ]
}
