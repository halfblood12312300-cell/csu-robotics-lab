{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "csu-robotics-api",
  "main": "index.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "vars": {
    "FRONTEND_ORIGIN": "https://halfblood12312300-cell.github.io",
    "FRONTEND_BASE_PATH": "/csu-robotics-lab"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "csu-robotics-lab",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "csu-robotics-media" }
  ]
}
